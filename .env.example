# SENTINEL-FL — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
#
# All values have sane defaults in configs/default.yaml.
# Only override here what differs per machine / deployment.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Root directory for all experiment artefacts (JSON logs, model checkpoints).
# Defaults to ./experiments relative to the project root.
SENTINEL_EXPERIMENTS_DIR=./experiments

# Root directory for YAML config files.
# Defaults to ./configs relative to the project root.
SENTINEL_CONFIGS_DIR=./configs

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
SENTINEL_LOG_LEVEL=INFO

# Log output: "stdout" or an absolute path to a .jsonl file.
SENTINEL_LOG_SINK=stdout

# ---------------------------------------------------------------------------
# FastAPI backend
# ---------------------------------------------------------------------------
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8000

# CORS origins (comma-separated). Allow the React dev server:
SENTINEL_API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# FL simulation (can also be set via configs/default.yaml)
# ---------------------------------------------------------------------------
# Number of simulated clients
SENTINEL_N_CLIENTS=12

# Number of FL rounds
SENTINEL_N_ROUNDS=20

# Global random seed for full reproducibility
SENTINEL_SEED=42

# ---------------------------------------------------------------------------
# Phase selection: "phase0_synthetic" or "phase1_official"
# ---------------------------------------------------------------------------
SENTINEL_DATASET_PHASE=phase0_synthetic

# Path to the official Phase 1 dataset root (only used when DATASET_PHASE=phase1_official)
# SENTINEL_DATASET_PATH=/path/to/official/dataset
