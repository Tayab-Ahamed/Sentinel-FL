# SENTINEL-FL — Git line-ending normalization
# Ensures consistent LF in the repo regardless of OS.

# Default: normalise to LF on check-in
* text=auto eol=lf

# Explicitly text files
*.py     text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.jsonl  text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.sh     text eol=lf
*.env    text eol=lf

# Binary files — never touch
*.png    binary
*.jpg    binary
*.gif    binary
*.svg    binary
*.ico    binary
*.npz    binary
*.npy    binary
*.whl    binary
